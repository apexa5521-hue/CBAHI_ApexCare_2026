# Copy to .env and fill in the keys you have. Leave a line empty to skip that
# provider. All of these are free tiers with no credit card.
GROQ_API_KEY=            # https://console.groq.com/keys
GEMINI_API_KEY=          # https://aistudio.google.com/apikey
NVIDIA_API_KEY=          # https://build.nvidia.com (NVIDIA Developer Program)
MISTRAL_API_KEY=         # https://console.mistral.ai/api-keys
CLOUDFLARE_API_TOKEN=    # https://dash.cloudflare.com/profile/api-tokens (Workers AI permission)
CLOUDFLARE_ACCOUNT_ID=   # shown on the Cloudflare dashboard sidebar
OPENROUTER_API_KEY=      # https://openrouter.ai/keys
OLLAMA_API_KEY=          # https://ollama.com/settings/keys
ZHIPU_API_KEY=           # https://open.bigmodel.cn/usercenter/apikeys
COHERE_API_KEY=          # https://dashboard.cohere.com/api-keys (non-commercial only)
SILICONFLOW_API_KEY=     # https://cloud.siliconflow.cn/account/ak
MODELSCOPE_API_KEY=      # https://modelscope.cn/my/myaccesstoken
HF_TOKEN=                # https://huggingface.co/settings/tokens
AION_API_KEY=            # https://www.aionlabs.ai/app/api-keys/
LLM7_API_KEY=            # optional, https://token.llm7.io (works without it)

# Kilo Code, LLM7 and OVHcloud need no key and are always used as last resort.
